# ── Database (Postgres — Neon, Supabase, Vercel Postgres, etc.) ───────────────
# Pooled connection string used at runtime by your app
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection string — required for Prisma migrations
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# In production set this to your Vercel domain, e.g. https://ridebuddy.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-strong-random-string"

# ── Razorpay (test mode) — leave blank to use the built-in mock payment flow ─
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Vercel Blob (for KYC + vehicle uploads in production) ────────────────────
# Auto-injected by Vercel when you enable the Blob integration. In local dev,
# leave empty to fall back to writing files into ./public/uploads/.
BLOB_READ_WRITE_TOKEN=""

# ── Email (verification + future transactional mail) ─────────────────────────
# Pick ONE provider:
#
# Option A — Resend (https://resend.com): paste your API key here.
RESEND_API_KEY=""
#
# Option B — Any SMTP server (Gmail, Outlook, Mailgun, SES, etc.). For Gmail,
# create a 16-char App Password at https://myaccount.google.com/apppasswords
# (you must have 2-Step Verification enabled). Use that as SMTP_PASS — your
# normal Gmail password will NOT work.
SMTP_HOST=""              # e.g. smtp.gmail.com
SMTP_PORT="465"           # 465 = SSL, 587 = STARTTLS
SMTP_USER=""              # your Gmail address
SMTP_PASS=""              # 16-character app password
#
# Verified sender. With Resend's onboarding domain you can use
# "onboarding@resend.dev". With Gmail SMTP it MUST match SMTP_USER.
EMAIL_FROM="RideBuddy <onboarding@resend.dev>"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="RideBuddy"
APP_URL="http://localhost:3000"

# ── Permanent admin (bootstrap script) ───────────────────────────────────────
# The build runs `scripts/ensure-admin.ts` on every deploy and upserts a user
# with isAdmin=true based on these values. Set them in Vercel's project
# Environment Variables (and locally below) so you always have an owner login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Owner"
ADMIN_PHONE="0000000000"
